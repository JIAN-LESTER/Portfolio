# Create an API key in Brevo under SMTP & API > API keys, then add these
# values to the Vercel project environment variables.
BREVO_API_KEY=xkeysib-your_api_key
CONTACT_TO_EMAIL=tabarno.jian@gmail.com
CONTACT_TO_NAME=Jian Lester Tabarno

# This sender address must be registered and verified in Brevo. To prevent
# Brevo from rewriting it to a brevosend.com address, authenticate the sender's
# domain in Brevo, then use an address from that authenticated domain here.
CONTACT_FROM_EMAIL=tabarno.jian@gmail.com
CONTACT_FROM_NAME=Jian Lester Tabarno
